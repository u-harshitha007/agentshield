# Mock Gateway Configuration

PORT=8001

# Default decision for tool calls (ALLOW, DENY, HOLD)
MOCK_DECISION=ALLOW

# Comma-separated list of high-risk tools that will be denied
HIGH_RISK_TOOLS=execute_payment,delete_supplier

# Approval threshold in INR (amounts above this trigger HOLD)
APPROVAL_THRESHOLD_INR=200000

# Must match AGENT_SERVICE_TOKEN used by the Agent Runtime
MOCK_SERVICE_TOKEN=local-agent-token
