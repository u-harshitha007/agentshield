# Agent Service Configuration

# Service
SERVICE_NAME=agent
SERVICE_PORT=8003
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://agent_svc:agent_password@postgres:5432/agentshield

# JWT Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=agentshield-demo

# Agent Service Token (for calling gateway)
AGENT_SERVICE_TOKEN=your-agent-service-token-here

# Gateway
GATEWAY_URL=http://gateway:8000

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120

# Agent Budgets
MAX_STEPS=12
MAX_TOOL_CALLS=20
MAX_REPLANS=2
MAX_WALL_SECONDS=180
MAX_LLM_CALLS=30

# Replay Mode (L0=live, L3=replay)
AGENT_MODE=L0
REPLAY_TRACE_PATH=traces/demo_golden.json

# Features
ENABLE_MEMORY=true
ENABLE_TRACING=true
